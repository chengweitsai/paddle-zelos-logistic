border-slate-200 text-slate-600 hover:bg-slate-50\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid of Gear Items */}\n      {filteredGear.length === 0 ? (\n        <div className=\"bg-white rounded-3xl border border-slate-100 p-8 text-center space-y-2\">\n          <HelpCircle size={32} className=\"text-slate-300 mx-auto\" />\n          <p className=\"text-sm font-semibold text-slate-500\">\346\211\276\344\270\215\345\210\260\347\233\270\347\254\246\347\232\204\350\243\235\345\202\231</p>\n          <p className=\"text-xs text-slate-400\">\350\253\213\345\230\227\350\251\246\346\233\264\346\224\271\346\220\234\345\260\213\351\227\234\351\215\265\345\255\227\343\200\202</p>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 gap-3.5\">\n          {filteredGear.map(item => (\n            <div \n              key={item.id} \n              onClick={() => setSelectedGear(item)}\n              id={`gear-card-${item.id}`}\n              className=\"bg-white rounded-2xl p-4 border border-slate-100 hover:border-emerald-500/30 hover:shadow-xs transition-all cursor-pointer text-left flex flex-col justify-between space-y-3 group\"\n            >\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-extrabold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md uppercase tracking-wider\">\n                    {getCategoryEmoji(item.category)} {getCategoryLabel(item.category)}\n                  </span>\n                  <span className=\"text-xs text-slate-400 font-bold group-hover:text-emerald-600 transition-colors\">\n                    \350\251\263\347\264\260\350\246\217\346\240\274 \342\206\222\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-slate-800 leading-tight group-hover:text-emerald-700 transition-colors\">\n                  {item.name}\n                </h3>\n                <p className=\"text-xs text-slate-500 leading-relaxed line-clamp-2\">\n                  {item.description}\n                </p>\n              </div>\n\n              {/* Highlights Specs Row */}\n              <div className=\"grid grid-cols-2 gap-2 text-[11px] border-t border-slate-50 pt-3\">\n                <div>\n                  <span className=\"text-slate-400 font-medium block\">\346\235\220\350\263\252</span>\n                  <span className=\"text-slate-700 font-semibold truncate block\">{item.specs.material}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 font-medium block\">\351\207\215\351\207\217</span>\n                  <span className=\"text-slate-700 font-semibold truncate block\">{item.specs.weight}</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Detail Bottom-Sheet / Dialog Modal */}\n      {selectedGear && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-end sm:items-center justify-center z-50 p-0 sm:p-4 animate-fadeIn\">\n          <div className=\"bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl max-h-[85vh] sm:max-h-[80vh] overflow-y-auto flex flex-col shadow-xl animate-slideUp\">\n            \n            {/* Modal Header */}\n            <div className=\"p-5 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white z-10\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-lg\">{getCategoryEmoji(selectedGear.category)}</span>\n                <div>\n                  <span className=\"text-[10px] font-extrabold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md uppercase tracking-wider block w-fit mb-0.5\">\n                    {getCategoryLabel(selectedGear.category)}\n            