      unified_diff {
        lines {
          text: "import fs from \'fs\';"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "const content = fs.readFileSync(\'sheet_meta.txt\', \'utf8\');"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "console.log(\'File size:\', content.length);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "console.log(content.substring(0, 500));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "// Let\'s find sheet definitions in the HTML bootstrapData."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "// Usually, it\'s inside `bootstrapData = {...}`. Let\'s find the sheet names."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "// In Google Sheets HTML, the tabs are listed with names. Let\'s find `\"title\":` or similar patterns,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "// or sheet titles."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "const regex = /\"([0-9a-zA-Z_\\u4e00-\\u9fa5\\s]+)\"\\s*,\\s*\\[\\s*\\[\\s*(\\d+)/g;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "// Let\'s also look for sheet names like \"\350\241\250\345\226\256\345\233\236\346\207\211 1\" or general names."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "const matches = content.match(/\"[^\"]+\"/g) || [];"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "console.log(\"Some quoted strings that look like tab names (longer than 3 chars):\");"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "const uniqueStrings = [...new Set(matches.map(s => s.replace(/\"/g, \'\')))]"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  .filter(s => s.length > 1 && s.length < 30)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  .filter(s => !s.includes(\'\\\\\') && !s.includes(\':\') && !s.includes(\'/\') && !s.includes(\'.\') && !s.includes(\'bootstrapData\'));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "console.log(uniqueStrings.slice(0, 100));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
  }
