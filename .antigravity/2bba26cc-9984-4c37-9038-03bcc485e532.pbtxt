    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-4\">\n      {/* Search and Category Quick Tabs */}\n      <div className=\"space-y-3 bg-white p-4 rounded-3xl border border-slate-100 shadow-2xs\">\n        <div className=\"relative\">\n          <input \n            type=\"text\" \n            placeholder=\"\346\220\234\345\260\213\346\247\263\343\200\201\346\225\221\347\224\237\350\241\243\343\200\201\345\261\201\345\242\212\343\200\201\350\246\217\346\240\274\343\200\201\346\235\220\350\263\252...\"\n            value={searchQuery}\n            onChange={e => setSearchQuery(e.target.value)}\n            className=\"w-full bg-slate-50 border border-slate-200/80 rounded-2xl pl-10 pr-4 py-2.5 text-sm font-medium text-slate-800 focus:outline-hidden focus:bg-white focus:border-blue-500 transition-all\"\n          />\n          <Search className=\"absolute left-3.5 top-3 text-slate-400\" size={16} />\n        </div>\n\n        {/* Categories Grid */}\n        <div className=\"flex gap-1 overflow-x-auto pb-1 max-w-full no-scrollbar\">\n          {[\n            { id: \'all\', label: \'\345\205\250\351\203\250\350\243\235\345\202\231 \360\237\217\267\357\270\217\' },\n            { id: \'paddle\', label: \'\351\276\215\350\210\237\346\247\263 \360\237\233\266\' },\n            { id: \'lifejacket\', label: \'\346\225\221\347\224\237\350\241\243 \360\237\216\275\' },\n            { id: \'buttpad\', label: \'\345\261\201\345\242\212 \360\237\215\221\' },\n            { id: \'accessory\', label: \'\351\205\215\344\273\266 \360\237\216\222\' }\n          ].map(tab => (\n            <button\n              key={tab.id}\n              onClick={() => setSelectedCategory(tab.id as any)}\n              className={`text-xs font-bold px-3.5 py-2 rounded-xl border whitespace-nowrap cursor-pointer transition-all ${\n                selectedCategory === tab.id \n                  ? \'bg-emerald-600 border-emerald-600 text-white shadow-xs\' \n                  : \'bg-white border-slate-200 text-slate-600 hover:bg-slate-50\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid of Gear Items */}\n      {filteredGear.length === 0 ? (\n        <div className=\"bg-white rounded-3xl border border-slate-100 p-8 text-center space-y-2\">\n          <HelpCircle size={32} className=\"text-slate-300 mx-auto\" />\n          <p className=\"text-sm font-semibold text-slate-500\">\346\211\276\344\270\215\345\210\260\347\233\270\347\254\246\347\232\204\350\243\235\345\202\231</p>\n          <p className=\"text-xs text-slate-400\">\350\253\213\345\230\227\350\251\246\346\233\264\346\224\271\346\220\234\345\260\213\351\227\234\351\215\265\345\255\227\343\200\202</p>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 gap-3.5\">\n          {filteredGear.map(item => (\n            <div \n              key={item.id} \n              onClick={() => setSelectedGear(item)}\n              id={`gear-card-${item.id}`}\n              className=\"bg-white rounded-2xl p-4 border border-slate-100 hover:border-emerald-500/30 hover:shadow-xs transition-all cursor-pointer text-left flex flex-col justify-between space-y-3 group\"\n            >\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-extrabold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md uppercase tracking-wider\">\n                    {getCategoryEmoji(item.category)} {getCategoryLabel(item.category)}\n                  </span>\n                  <span className=\"text-xs text-slate-400 font-bold group-hover:text-emerald-600 transition-colors\">\n                    \350\251\263\347\264\260\350\246\217\346\240\274 \342\206\222\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-slate-800 leading-tight group-hover:text-emerald-700 transition-colors\">\n                  {item.name}\n                </h3>\n                <p className=\"text-xs text-slate-500 leading-relaxed line-clamp-2\">\n                  {item.description}\n                </p>\n              </div>\n\n              {/* Highlights Specs Row */}\n              <div className=\"grid grid-cols-2 gap-2 text-[11px] border-t border-slate-50 pt-3\">\n                <div>\n                  <span className=\"text-slate-400 font-medium block\">\346\235\220\350\263\252</span>\n                  <span className=\"text-slate-700 font-semibold truncate block\">{item.specs.material}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 font-medium block\">\351\207\215\351\207\217</span>\n                  <span className=\"text-slate-700 font-semibold truncate block\">{item.specs.weight}</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Detail Bottom-Sheet / Dialog Modal */}\n      {selectedGear && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-end sm:items-center justify-center z-50 p-0 sm:p-4 animate-fadeIn\">\n          <div className=\"bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl max-h-[85vh] sm:max-h-[80vh] overflow-y-auto flex flex-col shadow-xl animate-slideUp\">\n            \n            {/* Modal Header */}\n            <div className=\"p-5 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white z-10\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-lg\">{getCategoryEmoji(selectedGear.category)}</span>\n                <div>\n                  <span className=\"text-[10px] font-extrabold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md uppercase tracking-wider block w-fit mb-0.5\">\n                    {getCategoryLabel(selectedGear.category)}\n                  </span>\n                  <h3 className=\"text-sm font-bold text-slate-800 leading-snug\">\n                    {selectedGear.name}\n                  </h3>\n                </div>\n              </div>\n              <button \n                onClick={() => setSelectedGear(null)}\n                id=\"btn-close-gear-detail\"\n                className=\"w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-colors\"\n              >\n                <X size={16} />\n              </button>\n            </div>\n\n            {/* Modal Content */}\n            <div className=\"p-5 space-y-5 text-left flex-1 overflow-y-auto\">\n              <div className=\"space-y-1.5\">\n                <span className=\"text-xs font-bold text-slate-400 flex items-center gap-1\">\n                  <Info size={13} className=\"text-blue-500\" />\n                  \350\243\235\345\202\231\347\260\241\344\273\213\n                </span>\n                <p className=\"text-xs text-slate-600 leading-relaxed\">\n                  {selectedGear.description}\n                </p>\n              </div>\n\n              {/* Specs parameters list */}\n              <div className=\"bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-3\">\n                <h4 className=\"text-xs font-bold text-slate-500 tracking-wider uppercase flex items-center gap-1\">\n                  <Award size={13} className=\"text-amber-500\" />\n                  \350\251\263\347\264\260\350\246\217\346\240\274\345\217\203\346\225\270\n                </h4>\n                <div className=\"space-y-2 text-xs\">\n                  <div className=\"grid grid-cols-3 py-1 border-b border-slate-200/50\">\n                    <span className=\"text-slate-400 font-medium\">\346\235\220\350\263\252</span>\n                    <span className=\"col-span-2 text-slate-700 font-semibold\">{selectedGear.specs.material}</span>\n                  </div>\n                  <div className=\"grid grid-cols-3 py-1 border-b border-slate-200/50\">\n                    <span className=\"text-slate-400 font-medium\">\351\207\215\351\207\217</span>\n                    <span className=\"col-span-2 text-slate-700 font-semibold\">{selectedGear.specs.weight}</span>\n                  </div>\n                  {selectedGear.specs.length && (\n                    <div className=\"grid grid-cols-3 py-1 border-b border-slate-200/50\">\n                      <span className=\"text-slate-400 font-medium\">\351\201\251\347\224\250\351\225\267\345\272\246</span>\n                      <span className=\"col-span-2 text-slate-700 font-semibold\">{selectedGear.specs.length}</span>\n                    </div>\n                  )}\n                  <div className=\"grid grid-cols-3 py-1\">\n                    <span className=\"text-slate-400 font-medium\">\347\211\271\350\211\262\350\246\201\351\273\236</span>\n                    <div className=\"col-span-2 text-slate-700 font-semibold space-y-1\">\n                      {selectedGear.specs.features.map((f, i) => (\n                        <div key={i} className=\"flex items-center gap-1\">\n                          <span className=\"text-emerald-500\">\342\234\223</span> {f}\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Suitability */}\n              <div className=\"space-y-1.5\">\n                <span className=\"text-xs font-bold text-slate-400 flex items-center gap-1\">\n                  <Sparkles size={13} className=\"text-purple-500\" />\n                  \351\201\251\345\220\210\345\260\215\350\261\241\350\210\207\345\273\272\350\255\260\n                </span>\n                <p className=\"text-xs text-slate-700 bg-purple-50/40 border border-purple-100/50 p-3 rounded-xl leading-relaxed\">\n                  {selectedGear.specs.suitability}\n                </p>\n              </div>\n\n              {/* Club rental option */}\n              <div className=\"bg-emerald-50/30 border border-emerald-100/50 p-4 rounded-2xl space-y-2 text-xs\">\n                <h4 className=\"font-bold text-emerald-800 flex items-center gap-1\">\n                  \360\237\233\266 \351\232\212\351\203\250\347\247\237\345\200\237\346\226\271\346\241\210\n                </h4>\n                <p className=\"text-slate-700 leading-relaxed font-medium\">\n                  {selectedGear.acquisition.clubRental}\n                </p>\n              </div>\n\n              {/* Acquisition and shopping link */}\n              <div className=\"space-y-3\">\n                <span className=\"text-xs font-bold text-slate-400 flex items-center gap-1\">\n                  <Tag size={13} className=\"text-orange-500\" />\n                  \347\215\262\345\217\226\351\200\224\345\276\221\350\210\207\345\217\203\350\200\203\345\203\271\346\240\274\n                </span>\n                <div className=\"space-y-2\">\n                  <div className=\"bg-orange-50/30 border border-orange-100/50 p-3.5 rounded-xl text-xs space-y-1\">\n                    <div className=\"flex justify-between font-bold text-orange-800\">\n                      <span>\350\263\274\350\262\267\346\226\271\345\274\217</span>\n                      <span>\351\240\220\344\274\260\345\203\271\346\240\274</span>\n                    </div>\n                    <div className=\"flex justify-between text-slate-600 font-medium\">\n                      <span className=\"max-w-[200px]\">{selectedGear.acquisition.method}</span>\n                      <span className=\"text-slate-800 font-bold\">{selectedGear.acquisition.priceRange}</span>\n                    </div>\n                  </div>\n\n                  {/* Purchase outbound links */}\n                  <div className=\"space-y-1.5\">\n                    {selectedGear.acquisition.links.map((link, idx) => (\n                      <a \n                        key={idx}\n                        href={link.url}\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                        className=\"w-full bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs p-3 rounded-xl flex items-center justify-between border border-slate-200 transition-colors\"\n                      >\n                        <span className=\"flex items-center gap-1.5 truncate max-w-[280px]\">\n                          \360\237\224\227 {link.label}\n                        </span>\n                        <ExternalLink size={13} className=\"text-slate-400 shrink-0\" />\n                      </a>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Modal Footer */}\n            <div className=\"p-4 border-t border-slate-100 bg-slate-50 text-center sticky bottom-0\">\n              <button \n                onClick={() => setSelectedGear(null)}\n                id=\"btn-close-gear-bottom\"\n                className=\"w-full bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs py-3 rounded-xl transition-colors\"\n              >\n                \345\233\236\345\210\260\350\243\235\345\202\231\345\272\253\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"space-y-4\">\n      {/* Search and Category Quick Tabs */}\n      <div className=\"space-y-3 bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n        <div className=\"relative\">\n          <input \n            type=\"text\" \n            placeholder=\"\346\220\234\345\260\213\346\247\263\343\200\201\346\225\221\347\224\237\350\241\243\343\200\201\345\261\201\345\242\212\343\200\201\350\246\217\346\240\274\343\200\201\346\235\220\350\263\252...\"\n            value={searchQuery}\n            onChange={e => setSearchQuery(e.target.value)}\n            className=\"w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 text-xs font-semibold text-slate-800 placeholder-slate-400 focus:outline-hidden focus:bg-white focus:border-[#06C755] focus:ring-2 focus:ring-[#06C755]/10 transition-all\"\n          />\n          <Search className=\"absolute left-3.5 top-3.5 text-slate-400\" size={15} />\n        </div>\n\n        {/* Categories Grid */}\n        <div className=\"flex gap-1 overflow-x-auto pb-1 max-w-full no-scrollbar\">\n          {[\n            { id: \'all\', label: \'\345\205\250\351\203\250\350\243\235\345\202\231 \360\237\217\267\357\270\217\' },\n            { id: \'paddle\', label: \'\351\276\215\350\210\237\346\247\263 \360\237\233\266\' },\n            { id: \'lifejacket\', label: \'\346\225\221\347\224\237\350\241\243 \360\237\216\275\' },\n            { id: \'buttpad\', label: \'\345\261\201\345\242\212 \360\237\215\221\' },\n            { id: \'accessory\', label: \'\351\205\215\344\273\266 \360\237\216\222\' }\n          ].map(tab => (\n            <button\n              key={tab.id}\n              onClick={() => setSelectedCategory(tab.id as any)}\n              className={`text-xs font-bold px-3.5 py-2 rounded-xl border whitespace-nowrap cursor-pointer transition-all ${\n                selectedCategory === tab.id \n                  ? \'bg-[#06C755] border-[#06C755] text-white shadow-xs\' \n                  : \'bg-white border-slate-200 text-slate-600 hover:bg-slate-50\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid of Gear Items */}\n      {filteredGear.length === 0 ? (\n        <div className=\"bg-white rounded-2xl border border-slate-200 p-8 text-center space-y-2\">\n          <HelpCircle size={32} className=\"text-slate-300 mx-auto\" />\n          <p className=\"text-sm font-semibold text-slate-500\">\346\211\276\344\270\215\345\210\260\347\233\270\347\254\246\347\232\204\350\243\235\345\202\231</p>\n          <p className=\"text-xs text-slate-400\">\350\253\213\345\230\227\350\251\246\346\233\264\346\224\271\346\220\234\345\260\213\351\227\234\351\215\265\345\255\227\343\200\202</p>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 gap-3.5\">\n          {filteredGear.map(item => (\n            <div \n              key={item.id} \n              onClick={() => setSelectedGear(item)}\n              id={`gear-card-${item.id}`}\n              className=\"bg-white rounded-xl p-4 border border-slate-200/80 hover:border-[#06C755]/30 hover:shadow-xs transition-all cursor-pointer text-left flex flex-col justify-between space-y-3 group\"\n            >\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-extrabold text-[#06C755] bg-[#06C755]/10 px-2 py-0.5 rounded-md uppercase tracking-wider\">\n                    {getCategoryEmoji(item.category)} {getCategoryLabel(item.category)}\n                  </span>\n                  <span className=\"text-xs text-slate-400 font-bold group-hover:text-[#06C755] transition-colors\">\n                    \350\251\263\347\264\260\350\246\217\346\240\274 \342\206\222\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-slate-800 leading-tight group-hover:text-[#06C755] transition-colors\">\n                  {item.name}\n                </h3>\n                <p className=\"text-xs text-slate-500 leading-relaxed line-clamp-2\">\n                  {item.description}\n                </p>\n              </div>\n\n              {/* Highlights Specs Row */}\n              <div className=\"grid grid-cols-2 gap-2 text-[11px] border-t border-slate-100 pt-3\">\n                <div>\n                  <span className=\"text-slate-400 font-medium block\">\346\235\220\350\263\252</span>\n                  <span className=\"text-slate-700 font-semibold truncate block\">{item.specs.material}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 font-medium block\">\351\207\215\351\207\217</span>\n                  <span className=\"text-slate-700 font-semibold truncate block\">{item.specs.weight}</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Detail Bottom-Sheet / Dialog Modal */}\n      {selectedGear && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-end sm:items-center justify-center z-50 p-0 sm:p-4 animate-fadeIn\">\n          <div className=\"bg-white w-full max-w-md rounded-t-2xl sm:rounded-2xl max-h-[85vh] sm:max-h-[80vh] overflow-y-auto flex flex-col shadow-2xl animate-slideUp\">\n            \n            {/* Modal Header */}\n            <div className=\"p-5 border-b border-slate-200 flex items-center justify-between sticky top-0 bg-white z-10\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-lg\">{getCategoryEmoji(selectedGear.category)}</span>\n                <div>\n                  <span className=\"text-[10px] font-extrabold text-[#06C755] bg-[#06C755]/10 px-2 py-0.5 rounded-md uppercase tracking-wider block w-fit mb-0.5\">\n                    {getCategoryLabel(selectedGear.category)}\n                  </span>\n                  <h3 className=\"text-sm font-bold text-slate-800 leading-snug\">\n                    {selectedGear.name}\n                  </h3>\n                </div>\n              </div>\n              <button \n                onClick={() => setSelectedGear(null)}\n                id=\"btn-close-gear-detail\"\n                className=\"w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-colors\"\n              >\n                <X size={16} />\n              </button>\n            </div>\n\n            {/* Modal Content */}\n            <div className=\"p-5 space-y-5 text-left flex-1 overflow-y-auto\">\n              <div className=\"space-y-1.5\">\n                <span className=\"text-xs font-bold text-slate-400 flex items-center gap-1\">\n                  <Info size={13} className=\"text-[#06C755]\" />\n                  \350\243\235\345\202\231\347\260\241\344\273\213\n                </span>\n                <p className=\"text-xs text-slate-600 leading-relaxed\">\n                  {selectedGear.description}\n                </p>\n              </div>\n\n              {/* Specs parameters list */}\n              <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3\">\n                <h4 className=\"text-xs font-bold text-slate-500 tracking-wider uppercase flex items-center gap-1\">\n                  <Award size={13} className=\"text-amber-500\" />\n                  \350\251\263\347\264\260\350\246\217\346\240\274\345\217\203\346\225\270\n                </h4>\n                <div className=\"space-y-2 text-xs\">\n                  <div className=\"grid grid-cols-3 py-1 border-b border-slate-200/50\">\n                    <span className=\"text-slate-400 font-medium\">\346\235\220\350\263\252</span>\n                    <span className=\"col-span-2 text-slate-700 font-semibold\">{selectedGear.specs.material}</span>\n                  </div>\n                  <div className=\"grid grid-cols-3 py-1 border-b border-slate-200/50\">\n                    <span className=\"text-slate-400 font-medium\">\351\207\215\351\207\217</span>\n                    <span className=\"col-span-2 text-slate-700 font-semibold\">{selectedGear.specs.weight}</span>\n                  </div>\n                  {selectedGear.specs.length && (\n                    <div className=\"grid grid-cols-3 py-1 border-b border-slate-200/50\">\n                      <span className=\"text-slate-400 font-medium\">\351\201\251\347\224\250\351\225\267\345\272\246</span>\n                      <span className=\"col-span-2 text-slate-700 font-semibold\">{selectedGear.specs.length}</span>\n                    </div>\n                  )}\n                  <div className=\"grid grid-cols-3 py-1\">\n                    <span className=\"text-slate-400 font-medium\">\347\211\271\350\211\262\350\246\201\351\273\236</span>\n                    <div className=\"col-span-2 text-slate-700 font-semibold space-y-1\">\n                      {selectedGear.specs.features.map((f, i) => (\n                        <div key={i} className=\"flex items-center gap-1\">\n                          <span className=\"text-[#06C755]\">\342\234\223</span> {f}\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Suitability */}\n              <div className=\"space-y-1.5\">\n                <span className=\"text-xs font-bold text-slate-400 flex items-center gap-1\">\n                  <Sparkles size={13} className=\"text-purple-500\" />\n                  \351\201\251\345\220\210\345\260\215\350\261\241\350\210\207\345\273\272\350\255\260\n                </span>\n                <p className=\"text-xs text-slate-700 bg-purple-50/40 border border-purple-100/50 p-3 rounded-xl leading-relaxed\">\n                  {selectedGear.specs.suitability}\n                </p>\n              </div>\n\n              {/* Club rental option */}\n              <div className=\"bg-[#06C755]/5 border border-[#06C755]/15 p-4 rounded-xl space-y-2 text-xs\">\n                <h4 className=\"font-bold text-[#06C755] flex items-center gap-1\">\n                  \360\237\233\266 \351\232\212\351\203\250\347\247\237\345\200\237\346\226\271\346\241\210\n                </h4>\n                <p className=\"text-slate-700 leading-relaxed font-semibold\">\n                  {selectedGear.acquisition.clubRental}\n                </p>\n              </div>\n\n              {/* Acquisition and shopping link */}\n              <div className=\"space-y-3\">\n                <span className=\"text-xs font-bold text-slate-400 flex items-center gap-1\">\n                  <Tag size={13} className=\"text-orange-500\" />\n                  \347\215\262\345\217\226\351\200\224\345\276\221\350\210\207\345\217\203\350\200\203\345\203\271\346\240\274\n                </span>\n                <div className=\"space-y-2\">\n                  <div className=\"bg-orange-50/30 border border-orange-100/50 p-3.5 rounded-xl text-xs space-y-1\">\n                    <div className=\"flex justify-between font-bold text-orange-800\">\n                      <span>\350\263\274\350\262\267\346\226\271\345\274\217</span>\n                      <span>\351\240\220\344\274\260\345\203\271\346\240\274</span>\n                    </div>\n                    <div className=\"flex justify-between text-slate-600 font-semibold\">\n                      <span className=\"max-w-[200px]\">{selectedGear.acquisition.method}</span>\n                      <span className=\"text-slate-800 font-bold\">{selectedGear.acquisition.priceRange}</span>\n                    </div>\n                  </div>\n\n                  {/* Purchase outbound links */}\n                  <div className=\"space-y-1.5\">\n                    {selectedGear.acquisition.links.map((link, idx) => (\n                      <a \n                        key={idx}\n                        href={link.url}\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                        className=\"w-full bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs p-3 rounded-xl flex items-center justify-between border border-slate-200 transition-colors\"\n                      >\n                        <span className=\"flex items-center gap-1.5 truncate max-w-[280px]\">\n                          \360\237\224\227 {link.label}\n                        </span>\n                        <ExternalLink size={13} className=\"text-slate-400 shrink-0\" />\n                      </a>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Modal Footer */}\n            <div className=\"p-4 border-t border-slate-200 bg-slate-50 text-center sticky bottom-0\">\n              <button \n                onClick={() => setSelectedGear(null)}\n                id=\"btn-close-gear-bottom\"\n                className=\"w-full bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs py-3 rounded-xl transition-colors cursor-pointer\"\n              >\n                \345\233\236\345\210\260\350\243\235\345\202\231\345\272\253\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
