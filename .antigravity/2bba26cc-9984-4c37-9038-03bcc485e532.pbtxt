    replacement_chunks {
      replacement_content: "import { GearItem } from \'./types\';\n\nexport const GEAR_DATABASE: GearItem[] = [\n  {\n    id: \'carbon-paddle-elite\',\n    name: \'IDBF \350\252\215\350\255\211\346\245\265\350\274\225\351\207\217\347\242\263\347\272\226\347\266\255\346\247\263 (\347\253\266\350\263\275\345\236\213)\',\n    category: \'paddle\',\n    specs: {\n      material: \'100% \346\235\261\351\272\227\351\253\230\346\250\241\346\225\270\347\242\263\347\272\226\347\266\255 (Toray T800)\',\n      weight: \'320g - 350g\',\n      length: \'44 - 51 \350\213\261\345\220\213 (\345\217\257\350\252\277\347\257\200\346\210\226\345\233\272\345\256\232\351\225\267\345\272\246)\',\n      features: [\'IDBF 202a \350\246\217\346\240\274\350\252\215\350\255\211\', \'\344\270\200\351\253\224\346\210\220\345\236\213\351\253\230\345\274\267\345\272\246\346\247\263\346\241\277\', \'\346\260\264\346\273\264\345\236\213\351\230\262\346\273\221\344\272\272\351\253\224\345\267\245\345\255\270 T\345\236\213\346\217\241\346\212\212\', \'\345\210\200\345\210\203\345\212\240\345\274\267\351\202\212\347\267\243\351\230\262\347\243\225\347\242\260\'],\n      suitability: \'\351\201\251\345\220\210\344\270\255\351\253\230\351\232\216\351\232\212\345\223\241\343\200\201\347\206\261\350\241\267\347\253\266\350\263\275\350\210\207\350\277\275\346\261\202\346\245\265\350\207\264\345\210\222\351\200\237\343\200\201\351\253\230\351\240\273\347\216\207\346\247\263\351\240\273\350\200\205\'\n    },\n    acquisition: {\n      method: \'\345\271\271\351\203\250\347\265\261\344\270\200\345\215\224\345\212\251\345\220\221\345\260\210\346\245\255\346\247\263\345\273\240\350\250\202\350\243\275 (Falcon / Hurricane / ZRE)\',\n      priceRange: \'NT$ 4,500 - NT$ 9,000\',\n      links: [\n        { label: \'ZRE \345\256\230\346\226\271\347\266\262\347\253\231 (\345\260\210\346\245\255\347\253\266\350\263\275\346\247\263)\', url: \'https://www.zre.com/\' },\n        { label: \'IDBF \350\252\215\350\255\211\34