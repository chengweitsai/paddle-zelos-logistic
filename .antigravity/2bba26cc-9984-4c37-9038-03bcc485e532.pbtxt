  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useCallback } from \'react\';\nimport { User } from \'firebase/auth\';\nimport { RentalRecord } from \'./types\';\nimport { AuthButton } from \'./components/AuthButton\';\nimport { GearDashboard } from \'./components/GearDashboard\';\nimport { GearDatabase } from \'./components/GearDatabase\';\nimport { AIConsultant } from \'./components/AIConsultant\';\nimport { \n  BarChart3, Tag, MessageCircle, Anchor, RefreshCw, \n  Settings, HelpCircle, FileSpreadsheet, ExternalLink \n} from \'lucide-react\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\'dashboard\' | \'database\' | \'consultant\'>(\'dashboard\');\n  const [user, setUser] = useState<User | null>(null);\n  const [oauthToken, setOauthToken] = useState<string | null>(null);\n  \n  // Spreadsheet data state\n  const [rentals, setRentals] = useState<RentalRecord[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Custom spreadsheet selection state for authorized users\n  const [customSpreadsheetId, setCustomSpreadsheetId] = useState(\'\');\n  const [showCustomConfig, setShowCustomConfig] = useState(false);\n\n  // Core fetch function\n  const fetchSheetData = useCallback(async (tokenToUse?: string | null, customId?: string) => {\n    setIsLoading(true);\n    setError(null);\n    try {\n      let url = \'/api/sheets/public\';\n      const headers: HeadersInit = {};\n\n      // If authorized user provides their own spreadsheet ID, pull using the Sheets API proxy\n      if (tokenToUse && customId) {\n        url = `/api/sheets/custom?spreadsheetId=${encodeURIComponent(customId)}&range=${encodeURIComponent(\'\350\241\250\345\226\256\345\233\236\346\207\211 1!A1:P200\')}`;\n        headers[\'Authorization\'] = `Bearer ${tokenToUse}`;\n      }\n\n      const res = await fetch(url, { headers });\n      if (!res.ok) {\n        throw new Error(`\351\200\243\347\267\232\344\274\272\346\234\215\345\231\250\345\244\261\346\225\227 (HTTP ${res.status})`);\n      }\n\n      const data = await res.json();\n      if (!data.success) {\n        throw new Error(data.error || \'\350\247\243\346\236\220\350\263\207\346\226\231\345\244\261\346\225\227\');\n      }\n\n      // If using Sheets API proxy, we need to map raw values list\n      if (tokenToUse && customId) {\n        // Raw Sheets API returns { values: string[][] }\n        const rawValues = data.data.values;\n        if (!rawValues || rawValues.length < 2) {\n          throw new Error(\'\350\251\246\347\256\227\350\241\250\344\270\255\347\204\241\346\234\211\346\225\210\347\232\204\347\247\237\345\200\237\347\264\200\351\214\204\346\210\226\346\254\204\344\275\215\344\270\215\347\254\246\345\220\210\350\246\217\347\257\204\');\n        }\n        \n        // Map row arrays to CSV grid parser structure\n        const headersList = rawValues[0].map((h: string) => h.toLowerCase());\n        const findIdx = (kws: string[]) => headersList.findIndex((h: string) => kws.some(k => h.includes(k)));\n        \n        // Similar mapping logic as server\n        const records: RentalRecord[] = [];\n        for (let r = 1; r < rawValues.length; r++) {\n          const row = rawValues[r];\n          if (!row || row.length === 0 || !row[findIdx([\'\345\200\237\347\224\250\344\272\272\'])]) continue;\n          \n          const getVal = (idx: number, fallback = \'\') => (idx >= 0 && idx < row.length ? row[idx] : fallback);\n          const parseNum = (str: string) => {\n            const n = parseInt(str.replace(/[^0-9]/g, \'\'), 10);\n            return isNaN(n) ? 0 : n;\n          };\n          \n          records.push({\n            id: `${r}-${getVal(findIdx([\'\346\231\202\351\226\223\']))}`,\n            timestamp: getVal(findIdx([\'\346\231\202\351\226\223\346\210\263\350\250\230\', \'\346\231\202\351\226\223\'])),\n            borrower: getVal(findIdx([\'\345\200\237\347\224\250\344\272\272\'])),\n            confirmed: getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'\346\230\257\') || getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'\345\267\262\'),\n            paymentConfirmed: getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'\346\230\257\') || getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'\345\267\262\'),\n            rentalDate: getVal(findIdx([\'\345\200\237\347\224\250\346\227\245\346\234\237\'])) || getVal(findIdx([\'\346\231\202\351\226\223\346\210\263\350\250\230\', \'\346\231\202\351\226\223\'])).split(\' \')[0] || \'\',\n            returnDate: getVal(findIdx([\'\346\255\270\351\202\204\'])),\n            carbonPaddlesCount: parseNum(getVal(findIdx([\'\347\242\263\347\272\226\347\266\255\346\247\263\345\271\276\351\232\273\', \'\347\242\263\347\272\226\347\266\255\346\247\263\346\225\270\351\207\217\']))),\n            carbonPaddleNumbers: getVal(findIdx([\'\347\242\263\347\272\226\347\266\255\346\247\263\347\267\250\350\231\237\'])),\n            woodPaddlesCount: parseNum(getVal(findIdx([\'\346\234\250\346\247\263\345\271\276\351\232\273\', \'\346\234\250\346\247\263\346\225\270\351\207\217\']))),\n            woodPaddleNumbers: getVal(findIdx([\'\346\234\250\346\247\263\347\267\250\350\231\237\'])),\n            lifeJacketRequested: getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\'])).includes(\'\345\200\237\'),\n            lifeJacketCount: parseNum(getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\']))) || (getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\'])).includes(\'\345\200\237\') ? 1 : 0),\n            buttPadRequested: getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\345\200\237\'),\n            buttPadCount: parseNum(getVal(findIdx([\'\345\261\201\345\242\212\']))) || (getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\345\200\237\') ? 1 : 0),\n            nextPracticePrep: getVal(findIdx([\'\344\270\213\346\254\241\347\267\264\347\277\222\'])),\n            notes: getVal(findIdx([\'\346\226\260\344\272\272\', \'\345\202\231\350\250\273\'])),\n            quantity: 1\n          });\n        }\n        setRentals(records);\n      } else {\n        // Direct public parser response\n        setRentals(data.rentals || []);\n      }\n    } catch (err: any) {\n      console.error(\'Fetch data error:\', err);\n      setError(err.message || \'\347\204\241\346\263\225\344\270\213\350\274\211\346\210\226\350\247\243\346\236\220\350\243\235\345\202\231\350\251\246\347\256\227\350\241\250\343\200\202\');\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  // Fetch public spreadsheet on mount\n  useEffect(() => {\n    fetchSheetData();\n  }, [fetchSheetData]);\n\n  const handleAuthChange = (currentUser: User | null, token: string | null) => {\n    setUser(currentUser);\n    setOauthToken(token);\n    // If user logged out, fallback to public sheet\n    if (!currentUser) {\n      fetchSheetData();\n    }\n  };\n\n  const handleApplyCustomSheet = () => {\n    if (!customSpreadsheetId.trim()) return;\n    fetchSheetData(oauthToken, customSpreadsheetId.trim());\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 flex flex-col justify-between antialiased\">\n      {/* Outer shell mimicking a mobile viewport in desktop view */}\n      <div className=\"w-full max-w-[480px] mx-auto bg-slate-50 flex-1 flex flex-col shadow-xl border-x border-slate-200 overflow-hidden\">\n        \n        {/* App Header Bar */}\n        <header className=\"bg-gradient-to-r from-emerald-700 to-teal-800 text-white p-5 space-y-3.5 shadow-md\">\n          <div className=\"flex justify-between items-start\">\n            <div className=\"space-y-1\">\n              <div className=\"flex items-center gap-1.5\">\n                <Anchor className=\"text-emerald-300 fill-emerald-300 animate-pulse\" size={20} />\n                <h1 className=\"text-lg font-black tracking-wider uppercase\">\351\276\215\350\210\237\345\205\254\347\224\250\350\243\235\345\202\231\347\213\200\346\205\213</h1>\n              </div>\n              <p className=\"text-xs text-emerald-100 font-medium tracking-wide\">\351\201\251\345\220\210 LINE \345\205\247\351\273\236\351\226\261\347\232\204\345\215\263\346\231\202\345\200\237\347\224\250\347\234\213\346\235\277</p>\n            </div>\n            \n            {/* Status indicator pill */}\n            <span className=\"text-[10px] font-extrabold bg-emerald-600/60 border border-emerald-500 text-emerald-100 px-2 py-0.5 rounded-full uppercase tracking-wider flex items-center gap-1\">\n              <span className=\"w-1.5 h-1.5 bg-emerald-300 rounded-full animate-ping\" />\n              LIVE \351\200\243\347\267\232\n            </span>\n          </div>\n\n          {/* Source spreadsheet link banner */}\n          <div className=\"flex items-center justify-between bg-emerald-900/40 border border-emerald-600/50 p-2.5 rounded-2xl text-[11px] font-medium text-emerald-100\">\n            <div className=\"flex items-center gap-1.5\">\n              <FileSpreadsheet size={13} className=\"text-emerald-300 shrink-0\" />\n              <span className=\"truncate max-w-[190px]\">\n                {customSpreadsheetId ? \'\350\207\252\350\250\202\350\251\246\347\256\227\350\241\250\' : \'\351\240\220\350\250\255\345\205\254\347\224\250\350\263\207\346\226\231\345\272\253 (\350\251\246\347\256\227\350\241\250)\'}\n              </span>\n            </div>\n            <a \n              href=\"https://docs.google.com/spreadsheets/d/1VOencdl4jRY2xh-L-ZkE7QVaP_XcYrTnZ8rL4FI1SFI/edit?resourcekey=&gid=288109580#gid=288109580\" \n              target=\"_blank\" \n              rel=\"noreferrer\" \n              className=\"text-emerald-300 hover:text-white font-bold flex items-center gap-0.5 shrink-0\"\n            >\n              \351\226\213\345\225\237\350\251\246\347\256\227\350\241\250 <ExternalLink size={10} />\n            </a>\n          </div>\n        </header>\n\n        {/* Dynamic Workspace Container */}\n        <main className=\"flex-1 p-4 overflow-y-auto space-y-4\">\n          \n          {/* Authenticated user features */}\n          {oauthToken && (\n            <div className=\"bg-white rounded-3xl p-4 border border-slate-100 shadow-2xs space-y-3\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-xs font-bold text-slate-500\">\350\251\246\347\256\227\350\241\250\351\200\243\346\216\245\351\201\270\351\240\205</span>\n                <button \n                  onClick={() => setShowCustomConfig(!showCustomConfig)}\n                  id=\"btn-toggle-custom-sheet\"\n                  className=\"text-xs font-bold text-blue-600 hover:underline\"\n                >\n                  {showCustomConfig ? \'\346\224\266\345\220\210\' : \'\351\200\243\347\267\232\350\207\252\350\250\202\350\251\246\347\256\227\350\241\250 ID\'}\n                </button>\n              </div>\n\n              {showCustomConfig && (\n                <div className=\"space-y-2.5\">\n                  <p className=\"text-[10px] text-slate-400 font-medium\">\n                    \346\202\250\345\217\257\344\273\245\350\274\270\345\205\245\345\217\246\344\270\200\345\200\213 Google \350\251\246\347\256\227\350\241\250 ID \344\275\234\347\202\272\346\225\270\346\223\232\346\272\220\357\274\210\346\254\204\344\275\215\346\240\274\345\274\217\351\234\200\350\210\207\351\240\220\350\250\255\350\241\250\346\240\274\344\270\200\350\207\264\357\274\211\357\274\232\n                  </p>\n                  <div className=\"flex gap-2\">\n                    <input \n                      type=\"text\" \n                      placeholder=\"\350\274\270\345\205\245 Spreadsheet ID...\"\n                      value={customSpreadsheetId}\n                      onChange={e => setCustomSpreadsheetId(e.target.value)}\n                      className=\"flex-1 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 focus:outline-hidden focus:bg-white\"\n                    />\n                    <button \n                      onClick={handleApplyCustomSheet}\n                      id=\"btn-apply-custom-sheet\"\n                      className=\"bg-slate-800 text-white font-bold text-xs px-3.5 rounded-xl hover:bg-slate-900 transition-colors\"\n                    >\n                      \351\200\243\347\267\232\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* Active Tab View Rendering */}\n          <div className=\"pb-16\">\n            {activeTab === \'dashboard\' && (\n              <GearDashboard \n                rentals={rentals} \n                isLoading={isLoading} \n                onRefresh={() => fetchSheetData(oauthToken, customSpreadsheetId)} \n                error={error}\n              />\n            )}\n\n            {activeTab === \'database\' && <GearDatabase />}\n\n            {activeTab === \'consultant\' && <AIConsultant />}\n          </div>\n        </main>\n\n        {/* Floating/Bottom Auth Profile Container */}\n        <div className=\"px-4 py-3 bg-white border-t border-slate-100 shadow-md\">\n          <AuthButton onAuthChange={handleAuthChange} />\n        </div>\n\n        {/* Sticky LINE-styled Bottom Navigation Bar */}\n        <nav className=\"bg-white border-t border-slate-200 px-3 py-2 flex justify-around items-center sticky bottom-0 z-20\">\n          {[\n            { id: \'dashboard\', label: \'\347\213\200\346\205\213\347\234\213\346\235\277\', icon: <BarChart3 size={18} />, colorClass: \'text-blue-600\' },\n            { id: \'database\', label: \'\350\251\263\