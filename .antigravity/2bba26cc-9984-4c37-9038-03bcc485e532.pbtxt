awValues.length < 2) {\n          throw new Error(\'\350\251\246\347\256\227\350\241\250\344\270\255\347\204\241\346\234\211\346\225\210\347\232\204\347\247\237\345\200\237\347\264\200\351\214\204\346\210\226\346\254\204\344\275\215\344\270\215\347\254\246\345\220\210\350\246\217\347\257\204\');\n        }\n        \n        // Map row arrays to CSV grid parser structure\n        const headersList = rawValues[0].map((h: string) => h.toLowerCase());\n        const findIdx = (kws: string[]) => headersList.findIndex((h: string) => kws.some(k => h.includes(k)));\n        \n        // Similar mapping logic as server\n        const records: RentalRecord[] = [];\n        for (let r = 1; r < rawValues.length; r++) {\n          const row = rawValues[r];\n          if (!row || row.length === 0 || !row[findIdx([\'\345\200\237\347\224\250\344\272\272\'])]) continue;\n          \n          const getVal = (idx: number, fallback = \'\') => (idx >= 0 && idx < row.length ? row[idx] : fallback);\n          const parseNum = (str: string) => {\n            const n = parseInt(str.replace(/[^0-9]/g, \'\'), 10);\n            return isNaN(n) ? 0 : n;\n          };\n          \n          records.push({\n            id: `${r}-${getVal(findIdx([\'\346\231\202\351\226\223\']))}`,\n            timestamp: getVal(findIdx([\'\346\231\202\351\226\223\346\210\263\350\250\230\', \'\346\231\202\351\226\223\'])),\n            borrower: getVal(findIdx([\'\345\200\237\347\224\250\344\272\272\'])),\n            confirmed: getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'\346\230\257\') || getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'\345\267\262\'),\n            paymentConfirmed: getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'\346\230\257\') || getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'\345\267\262\'),\n            rentalDate: getVal(findIdx([\'\345\200\237\347\224\250\346\227\245\346\234\237\'])) || getVal(findIdx([\'\346\231\202\351\226\223\346\210\263\350\250\230\', \'\346\231\202\351\226\223\'])).split(\' \')[0] || \'\',\n            returnDate: getVal(findIdx([\'\346\255\270\351\202\204\'])),\n            carbonPaddlesCount: parseNum(getVal(findIdx([\'\347\242\263\347\272\226\347\266\255\346\247\263\345\271\276\351\232\273\', \'\347\242\263\347\272\226\347\266\255\346\247\263\346\225\270\351\207\217\']))),\n            carbonPaddleNumbers: getVal(findIdx([\'\347\242\263\347\272\226\347\266\255\346\247\263\347\267\250\350\231\237\'])),\n            woodPaddlesCount: parseNum(getVal(findIdx([\'\346\234\250\346\247\263\345\271\276\351\232\273\', \'\346\234\250\346\247\263\346\225\270\351\207\217\']))),\n            woodPaddleNumbers: getVal(findIdx([\'\346\234\250\346\247\263\347\267\250\350\231\237\'])),\n            lifeJacketRequested: getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\'])).includes(\'\345\200\237\'),\n            lifeJacketCount: parseNum(getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\']))) || (getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\'])).includes(\'\345\200\237\') ? 1 : 0),\n            buttPadRequested: getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\345\200\237\'),\n            buttPadCount: parseNum(getVal(findIdx([\'\345\261\201\345\242\212\']))) || (getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\345\200\237\') ? 1 : 0),\n            nextPracticePrep: getVal(findIdx([\'\344\270\213\346\254\241\347\267\264\347\277\222\'])),\n            notes: getVal(findIdx([\'\346\226\260\344\272\272\', \'\345\202\231\350\250\273\'])),\n            quantity: 1\n          });\n        }\n        setRentals(records);\n      } else {\n        // Direct public parser response\n        setRentals(data.rentals || []);\n      }\n    } catch (err: any) {\n      console.error(\'Fetch data error:\', err);\n      setError(err.message || \'\347\204\241\346\263\225\344\270\213\350\274\211\346\210\226\350\247\243\346\236\220\350\243\235\345\202\231\350\251\246\347\256\227\350\241\250\343\200\202\');\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  // Fetch public spreadsheet on mount\n  useEffect(() => {\n    fetchSheetData();\n  }, [fetchSheetData]);\n\n  const handleAuthChange = (currentUser: User | null, token: string | null) => {\n    setUser(currentUser);\n    setOauthToken(token);\n    // If user logged out, fallback to public sheet\n    if (!currentUser) {\n      fetchSheetData();\n    }\n  };\n\n  const handleApplyCustomSheet = () => {\n    if (!customSpreadsheetId.trim()) return;\n    fetchSheetData(oauthToken, customSpreadsheetId.trim());\n  };"
      replacement_content: "export default function App() {\n  const [activeTab, setActiveTab] = useState<\'dashboard\' | \'database\' | \'consultant\'>(\'dashboard\');\n  const [user, setUser] = useState<User | null>(null);\n  const [oauthToken, setOauthToken] = useState<string | null>(null);\n  \n  // Spreadsheet data state\n  const [rentals, setRentals] = useState<RentalRecord[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Custom spreadsheet selection state for authorized users - persistent in localStorage\n  const [customSpreadsheetId, setCustomSpreadsheetId] = useState(() => {\n    return localStorage.getItem(\'customSpreadsheetId\') || \'\';\n  });\n  const [showCustomConfig, setShowCustomConfig] = useState(false);\n\n  // Core fetch function (100% client-side for GitHub Pages static compatibility)\n  const fetchSheetData = useCallback(async (tokenToUse?: string | null, customId?: string) => {\n    setIsLoading(true);\n    setError(null);\n    try {\n      let rentalsData: RentalRecord[] = [];\n\n      // If authorized user provides their own spreadsheet ID, fetch directly from Google Sheets API\n      if (tokenToUse && customId) {\n        const url = `https://sheets.googleapis.com/v4/spreadsheets/${encodeURIComponent(customId)}/values/${encodeURIComponent(\'\350\241\250\345\226\256\345\233\236\346\207\211 1!A1:P200\')}`;\n        const headers: HeadersInit = {\n          \'Authorization\': `Bearer ${tokenToUse}`\n        };\n        \n        const res = await fetch(url, { headers });\n        if (!res.ok) {\n          throw new Error(`\351\200\243\347\267\232 Google \350\251\246\347\256\227\350\241\250 API \345\244\261\346\225\227 (HTTP ${res.status})\343\200\202\350\253\213\347\242\272\350\252\215\346\202\250\350\274\270\345\205\245\347\232\204\350\251\246\347\256\227\350\241\250 ID \346\230\257\345\220\246\346\255\243\347\242\272\357\274\214\344\270\224\346\202\250\346\230\257\345\220\246\345\205\267\345\202\231\345\255\230\345\217\226\350\251\262\350\251\246\347\256\227\350\241\250\347\232\204\346\254\212\351\231\220\343\200\202`);\n        }\n\n        const data = await res.json();\n        const rawValues = data.values;\n        if (!rawValues || rawValues.length < 2) {\n          throw new Error(\'\350\251\246\347\256\227\350\241\250\344\270\255\347\204\241\344\273\273\344\275\225\347\247\237\345\200\237\347\264\200\351\214\204\357\274\214\346\210\226\350\263\207\346\226\231\346\240\274\345\274\217\350\210\207\346\254\204\344\275\215\345\220\215\347\250\261\344\270\215\347\254\246\350\246\217\347\257\204\343\200\202\');\n        }\n        \n        // Map row arrays to CSV grid parser structure\n        const headersList = rawValues[0].map((h: string) => h.toLowerCase());\n        const findIdx = (kws: string[]) => headersList.findIndex((h: string) => kws.some(k => h.includes(k)));\n        \n        const borrowerIdx = findIdx([\'\345\200\237\347\224\250\344\272\272\']);\n        if (borrowerIdx < 0) {\n          throw new Error(\'\350\251\246\347\256\227\350\241\250\344\270\255\346\211\276\344\270\215\345\210\260\343\200\214\345\200\237\347\224\250\344\272\272\343\200\215\346\254\204\344\275\215\357\274\214\350\253\213\347\242\272\350\252\215\350\251\246\347\256\227\350\241\250\346\240\274\345\274\217\343\200\202\');\n        }\n\n        const records: RentalRecord[] = [];\n        for (let r = 1; r < rawValues.length; r++) {\n          const row = rawValues[r];\n          if (!row || row.length === 0 || !row[borrowerIdx]) continue;\n          \n          const getVal = (idx: number, fallback = \'\') => (idx >= 0 && idx < row.length ? row[idx] : fallback);\n          const parseNum = (str: string) => {\n            const n = parseInt(str.replace(/[^0-9]/g, \'\'), 10);\n            return isNaN(n) ? 0 : n;\n          };\n          \n          records.push({\n            id: `${r}-${getVal(findIdx([\'\346\231\202\351\226\223\'])) || Date.now()}-${getVal(borrowerIdx)}`,\n            timestamp: getVal(findIdx([\'\346\231\202\351\226\223\346\210\263\350\250\230\', \'\346\231\202\351\226\223\'])),\n            borrower: getVal(borrowerIdx),\n            confirmed: getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'\346\230\257\') || getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'\345\267\262\') || getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'v\') || getVal(findIdx([\'\346\230\257\345\220\246\345\267\262\347\242\272\350\252\215\', \'\347\242\272\350\252\215\'])).includes(\'o\'),\n            paymentConfirmed: getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'\346\230\257\') || getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'\345\267\262\') || getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'v\') || getVal(findIdx([\'\344\273\230\346\254\276\', \'\350\277\275\345\270\263\'])).includes(\'o\'),\n            rentalDate: getVal(findIdx([\'\345\200\237\347\224\250\346\227\245\346\234\237\'])) || getVal(findIdx([\'\346\231\202\351\226\223\346\210\263\350\250\230\', \'\346\231\202\351\226\223\'])).split(\' \')[0] || \'\',\n            returnDate: getVal(findIdx([\'\346\255\270\351\202\204\'])),\n            carbonPaddlesCount: parseNum(getVal(findIdx([\'\347\242\263\347\272\226\347\266\255\346\247\263\345\271\276\351\232\273\', \'\347\242\263\347\272\226\347\266\255\346\247\263\346\225\270\351\207\217\']))),\n            carbonPaddleNumbers: getVal(findIdx([\'\347\242\263\347\272\226\347\266\255\346\247\263\347\267\250\350\231\237\'])),\n            woodPaddlesCount: parseNum(getVal(findIdx([\'\346\234\250\346\247\263\345\271\276\351\232\273\', \'\346\234\250\346\247\263\346\225\270\351\207\217\']))),\n            woodPaddleNumbers: getVal(findIdx([\'\346\234\250\346\247\263\347\267\250\350\231\237\'])),\n            lifeJacketRequested: getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\'])).includes(\'\345\200\237\') || getVal(findIdx([\'\346\225\221\350\241\243\'])).includes(\'\351\234\200\'),\n            lifeJacketCount: parseNum(getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\']))) || (getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\'])).includes(\'\345\200\237\') || getVal(findIdx([\'\346\225\221\347\224\237\350\241\243\'])).includes(\'\351\234\200\') ? 1 : 0),\n            buttPadRequested: getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\345\200\237\') || getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\351\234\200\'),\n            buttPadCount: parseNum(getVal(findIdx([\'\345\261\201\345\242\212\']))) || (getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\345\200\237\') || getVal(findIdx([\'\345\261\201\345\242\212\'])).includes(\'\351\234\200\') ? 1 : 0),\n            nextPracticePrep: getVal(findIdx([\'\344\270\213\346\254\241\347\267\264\347\277\222\', \'\345\271\271\351\203\250\345\271\253\346\210\221\346\272\226\345\202\231\'])),\n            notes: getVal(findIdx([\'\346\226\260\344\272\272\', \'\345\202\231\350\250\273\'])),\n            quantity: 1\n          });\n        }\n        rentalsData = records;\n      } else {\n        // Direct browser CSV fetch of public spreadsheet\n        const spreadsheetId = \'1VOencdl4jRY2xh-L-ZkE7QVaP_XcYrTnZ8rL4FI1SFI\';\n        const gid = \'288109580\';\n        const url = `https://docs.google.com/spreadsheets/d/${spreadsheetId}/export?format=csv&gid=${gid}`;\n        \n        const res = await fetch(url);\n        if (!res.ok) {\n          throw new Error(`\347\215\262\345\217\226 Google \350\251\246\347\256\227\350\241\250 CSV \345\244\261\346\225\227 (HTTP ${res.status})\343\200\202`);\n        }\n        \n        const csvText = await res.text();\n        const { mapCSVToRentals } = await import(\'./utils/csvParser\');\n        rentalsData = mapCSVToRentals(csvText);\n      }\n\n      setRentals(rentalsData);\n    } catch (err: any) {\n      console.error(\'Fetch data error:\', err);\n      setError(err.message || \'\347\204\241\346\263\225\344\270\213\350\274\211\346\210\226\350\247\243\346\236\220\350\243\235\345\202\231\350\251\246\347\256\227\350\241\250\343\200\202\');\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  // Fetch public or cached custom spreadsheet on mount\n  useEffect(() => {\n    const cachedId = localStorage.getItem(\'customSpreadsheetId\') || \'\';\n    if (oauthToken && cachedId) {\n      fetchSheetData(oauthToken, cachedId);\n    } else {\n      fetchSheetData(null, \'\');\n    }\n  }, [fetchSheetData, oauthToken]);\n\n  const handleAuthChange = (currentUser: User | null, token: string | null) => {\n    setUser(currentUser);\n    setOauthToken(token);\n    const cachedId = localStorage.getItem(\'customSpreadsheetId\') || \'\';\n    if (currentUser && cachedId) {\n      fetchSheetData(token, cachedId);\n    } else {\n      fetchSheetData(null, \'\');\n    }\n  };\n\n  const handleApplyCustomSheet = () => {\n    if (!customSpreadsheetId.trim()) {\n      localStorage.removeItem(\'customSpreadsheetId\');\n      fetchSheetData(oauthToken, \'\');\n      return;\n    }\n    const cleanId = customSpreadsheetId.trim();\n    localStorage.setItem(\'customSpreadsheetId\', cleanId);\n    fetchSheetData(oauthToken, cleanId);\n  };"
