      target_content: "  const progressColor = (ratio: number) => {\n    if (ratio >= 0.9) return \'bg-rose-500\';\n    if (ratio >= 0.7) return \'bg-amber-500\';\n    return \'bg-emerald-500\';\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      {/* Dynamic Inventory Ring / Bars */}\n      <div className=\"bg-white rounded-3xl p-5 border border-slate-100 shadow-xs space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Anchor className=\"text-blue-600 animate-pulse\" size={20} />\n            <h2 className=\"text-base font-bold text-slate-800\">\345\205\254\347\224\250\350\243\235\345\202\231\345\217\257\347\224\250\347\213\200\346\205\213</h2>\n          </div>\n          <button \n            onClick={() => {\n              setEditTotals({ ...totals });\n              setShowConfig(!showConfig);\n            }}\n            id=\"btn-toggle-inventory-config\"\n            className=\"flex items-center gap-1 text-xs text-slate-500 font-semibold hover:text-slate-800 p-1.5 rounded-lg hover:bg-slate-50 transition-colors\"\n          >\n            <Settings size={14} />\n            \350\250\255\345\256\232\347\270\275\351\207\217\n          </button>\n        </div>\n\n        {/* Configuration Panel */}\n        {showConfig && (\n          <div className=\"bg-slate-50 p-4 rounded-2xl border border-slate-200/60 space-y-3.5 animate-fadeIn\">\n            <h3 className=\"text-xs font-bold text-slate-600 tracking-wider uppercase\">\346\233\264\346\224\271\351\232\212\351\203\250\350\243\235\345\202\231\347\270\275\345\272\253\345\255\230</h3>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\347\242\263\347\272\226\347\266\255\346\247\263\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.carbonPaddle} \n                  onChange={e => setEditTotals({ ...editTotals, carbonPaddle: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-blue-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\346\234\250\346\247\263\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.woodPaddle} \n                  onChange={e => setEditTotals({ ...editTotals, woodPaddle: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-blue-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\346\225\221\347\224\237\350\241\243\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.lifeJacket} \n                  onChange={e => setEditTotals({ ...editTotals, lifeJacket: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-blue-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\345\261\201\345\242\212\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.buttPad} \n                  onChange={e => setEditTotals({ ...editTotals, buttPad: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-blue-500\"\n                />\n              </div>\n            </div>\n            <button \n              onClick={handleSaveConfig}\n              id=\"btn-save-inventory\"\n              className=\"w-full bg-blue-600 text-white font-bold text-sm py-2 rounded-xl hover:bg-blue-700 flex items-center justify-center gap-2 transition-colors\"\n            >\n              <Save size={15} />\n              \345\204\262\345\255\230\350\243\235\345\202\231\346\225\270\351\207\217\n            </button>\n          </div>\n        )}\n\n        {/* 4 Core Equipment Items Status Card */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {[\n            { label: \'\347\242\263\347\272\226\347\266\255\346\247\263\', stats: stats.carbonPaddle, unit: \'\346\224\257\', colorClass: \'from-slate-700 to-slate-900\', key: \'carbon\' },\n            { label: \'\346\234\250\346\247\263\', stats: stats.woodPaddle, unit: \'\346\224\257\', colorClass: \'from-amber-600 to-amber-800\', key: \'wood\' },\n            { label: \'\345\205\254\347\224\250\346\225\221\347\224\237\350\241\243\', stats: stats.lifeJacket, unit: \'\344\273\266\', colorClass: \'from-orange-500 to-orange-600\', key: \'jacket\' },\n            { label: \'\345\205\254\347\224\250\345\261\201\345\242\212\', stats: stats.buttPad, unit: \'\345\200\213\', colorClass: \'from-teal-500 to-teal-600\', key: \'pad\' }\n          ].map(item => {\n            const available = item.stats.total - item.stats.borrowed;\n            const ratio = item.stats.total > 0 ? item.stats.borrowed / item.stats.total : 0;\n            return (\n              <div key={item.key} className=\"bg-slate-50/50 rounded-2xl p-3.5 border border-slate-100/80 flex flex-col justify-between space-y-2\">\n                <div className=\"flex justify-between items-start\">\n                  <span className=\"text-xs font-bold text-slate-500\">{item.label}</span>\n                  <span className=\"text-[10px] bg-slate-200/50 text-slate-600 font-bold px-1.5 py-0.5 rounded-md\">\n                    \347\270\275\345\272\253\345\255\230 {item.stats.total}\n                  </span>\n                </div>\n                <div className=\"flex items-baseline gap-1\">\n                  <span className={`text-2xl font-black ${available === 0 ? \'text-rose-500\' : \'text-slate-800\'}`}>\n                    {available}\n                  </span>\n                  <span className=\"text-xs font-semibold text-slate-500\">{item.unit} \345\217\257\345\200\237</span>\n                </div>\n                {/* Micro Progress Bar */}\n                <div className=\"w-full bg-slate-200 h-1.5 rounded-full overflow-hidden\">\n                  <div \n                    className={`h-full rounded-full transition-all duration-500 ${progressColor(ratio)}`}\n                    style={{ width: `${ratio * 100}%` }}\n                  />\n                </div>\n                <div className=\"text-[10px] text-slate-400 font-medium\">\n                  \345\267\262\345\200\237\345\207\272 {item.stats.borrowed} {item.unit}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Rentals Filter & List */}\n      <div className=\"space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-1.5\">\n            <h3 className=\"text-sm font-bold text-slate-800\">\345\200\237\347\224\250\345\220\215\345\226\256\350\210\207\347\242\272\350\252\215\347\213\200\346\205\213</h3>\n            <span className=\"text-xs font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full\">\n              {rentals.length} \347\255\206\347\264\200\351\214\204\n            </span>\n          </div>\n          <button \n            onClick={onRefresh}\n            id=\"btn-refresh-data\"\n            disabled={isLoading}\n            className=\"p-1.5 rounded-xl hover:bg-slate-100 text-slate-500 hover:text-slate-800 transition-colors\"\n            title=\"\346\211\213\345\213\225\345\210\267\346\226\260\350\263\207\346\226\231\"\n          >\n            <RefreshCw size={15} className={isLoading ? \'animate-spin\' : \'\'} />\n          </button>\n        </div>\n\n        {/* Query Input */}\n        <div className=\"relative\">\n          <input \n            type=\"text\" \n            placeholder=\"\346\220\234\345\260\213\345\200\237\347\224\250\344\272\272\345\247\223\345\220\215\343\200\201\346\247\263\347\267\250\350\231\237\343\200\201\345\202\231\350\250\273...\"\n            value={searchQuery}\n            onChange={e => setSearchQuery(e.target.value)}\n            className=\"w-full bg-white border border-slate-200 rounded-2xl pl-10 pr-4 py-2.5 text-sm font-medium text-slate-800 focus:outline-hidden focus:border-blue-500 focus:ring-1 focus:ring-blue-500 shadow-2xs\"\n          />\n          <Search className=\"absolute left-3.5 top-3 text-slate-400\" size={16} />\n        </div>\n\n        {/* Filter Quick-Tabs */}\n        <div className=\"flex gap-1 overflow-x-auto pb-1 max-w-full no-scrollbar\">\n          {[\n            { id: \'all\', label: \'\345\205\250\351\203\250 \360\237\223\213\' },\n            { id: \'unconfirmed\', label: \'\345\271\271\351\203\250\346\234\252\347\242\272\350\252\215 \342\217\263\' },\n            { id: \'unpaid\', label: \'\346\234\252\344\273\230\346\254\276 \360\237\222\270\' },\n            { id: \'confirmed\', label: \'\345\267\262\347\242\272\350\252\215\345\220\210\346\240\274 \342\234\205\' }\n          ].map(tab => (\n            <button\n              key={tab.id}\n              onClick={() => setFilterType(tab.id as any)}\n              className={`text-xs font-bold px-3 py-2 rounded-xl whitespace-nowrap border transition-all cursor-pointer ${\n                filterType === tab.id \n                  ? \'bg-slate-800 border-slate-800 text-white shadow-xs\' \n                  : \'bg-white border-slate-200 text-slate-600 hover:bg-slate-50\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n\n        {/* List of Rentals */}\n        {error && (\n          <div className=\"bg-rose-50 border border-rose-100 rounded-2xl p-4 flex gap-2.5 text-rose-700 text-xs font-semibold\">\n            <AlertCircle size={16} className=\"shrink-0\" />\n            <div>\n              <p>\350\263\207\346\226\231\345\212\240\350\274\211\345\244\261\346\225\227\357\274\232{error}</p>\n              <button onClick={onRefresh} className=\"mt-1 text-blue-600 underline font-bold\">\351\273\236\346\255\244\351\207\215\350\251\246</button>\n            </div>\n          </div>\n        )}\n\n        {isLoading ? (\n          <div className=\"bg-white rounded-2xl border border-slate-100 p-8 text-center space-y-3\">\n            <div className=\"w-8 h-8 border-3 border-blue-600 border-t-transparent rounded-full animate-spin mx-auto\" />\n            <p className=\"text-xs text-slate-400 font-semibold\">\346\255\243\345\234\250\345\276\236 Google Sheet \350\274\211\345\205\245\345\215\263\346\231\202\350\243\235\345\202\231\347\247\237\345\200\237\347\213\200\346\205\213...</p>\n          </div>\n        ) : filteredRentals.length === 0 ? (\n          <div className=\"bg-white rounded-2xl border border-slate-100 p-8 text-center space-y-2\">\n            <HelpCircle size={32} className=\"text-slate-300 mx-auto\" />\n            <p className=\"text-sm font-semibold text-slate-500\">\347\204\241\347\254\246\345\220\210\346\242\235\344\273\266\347\232\204\345\200\237\347\224\250\347\264\200\351\214\204</p>\n            <p className=\"text-xs text-slate-400\">\350\253\213\345\230\227\350\251\246\346\233\264\346\224\271\351\227\234\351\215\265\345\255\227\346\210\226\347\257\251\351\201\270\345\210\206\351\241\236\343\200\202</p>\n          </div>\n        ) : (\n          <div className=\"space-y-3 max-h-[420px] overflow-y-auto pr-1\">\n            {filteredRentals.map(record => {\n              // Summarize gear for this borrower\n              const gears: string[] = [];\n              if (record.carbonPaddlesCount > 0) {\n                gears.push(`\347\242\263\347\272\226\346\247\263 x${record.carbonPaddlesCount}${record.carbonPaddleNumbers ? ` (${record.carbonPaddleNumbers})` : \'\'}`);\n              }\n              if (record.woodPaddlesCount > 0) {\n                gears.push(`\346\234\250\346\247\263 x${record.woodPaddlesCount}${record.woodPaddleNumbers ? ` (${record.woodPaddleNumbers})` : \'\'}`);\n              }\n              if (record.lifeJacketCount > 0) {\n                gears.push(`\346\225\221\347\224\237\350\241\243 x${record.lifeJacketCount}`);\n              }\n              if (record.buttPadCount > 0) {\n                gears.push(`\345\261\201\345\242\212 x${record.buttPadCount}`);\n              }\n\n              return (\n                <div \n                  key={record.id} \n                  className=\"bg-white rounded-2xl p-4 border border-slate-100 hover:border-slate-200 transition-all shadow-2xs space-y-3\"\n                >\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <div className=\"w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-600\">\n                        <User size={14} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-sm font-bold text-slate-800 leading-tight\">\n                          {record.borrower}\n                        </h4>\n                        <span className=\"text-[10px] text-slate-400 font-medium\">\n                          {record.timestamp}\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Status Badges */}\n                    <div className=\"flex flex-col items-end gap-1\">\n                      <div className=\"flex gap-1.5\">\n                        {record.confirmed ? (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-emerald-50 text-emerald-600 border border-emerald-100/50 px-1.5 py-0.5 rounded-md\">\n                            <ShieldCheck size={11} /> \345\271\271\351\203\250\345\267\262\347\242\272\350\252\215\n                          </span>\n                        ) : (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-amber-50 text-amber-600 border border-amber-100/50 px-1.5 py-0.5 rounded-md\">\n                            <ShieldAlert size={11} /> \346\234\252\346\240\270\345\260\215\n                          </span>\n                        )}\n                        \n                        {record.paymentConfirmed ? (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-blue-50 text-blue-600 border border-blue-100/50 px-1.5 py-0.5 rounded-md\">\n                            <CheckCircle2 size={11} /> \345\267\262\344\273\230\346\254\276\n                          </span>\n                        ) : (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-slate-50 text-slate-500 border border-slate-200 px-1.5 py-0.5 rounded-md\">\n                            \346\234\252\346\240\270\346\254\276\n                          </span>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Borrowed Gear Details */}\n                  <div className=\"bg-slate-50/50 p-2.5 rounded-xl border border-slate-100/50\">\n                    <div className=\"text-[10px] text-slate-400 font-bold mb-1 uppercase tracking-wider\">\345\200\237\347\224\250\346\270\205\345\226\256</div>\n                    {gears.length > 0 ? (\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {gears.map((g, i) => (\n                          <span key={i} className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200/50 px-2 py-1 rounded-lg\">\n                            {g}\n                          </span>\n                        ))}\n                      </div>\n                    ) : (\n                      <span className=\"text-xs text-slate-400 font-semibold\">\345\203\205\347\231\273\350\250\230\357\274\214\347\204\241\345\200\237\347\224\250\350\243\235\345\202\231</span>\n                    )}\n                  </div>\n\n                  {/* Extra specs or comments */}\n                  {(record.nextPracticePrep || record.notes) && (\n                    <div className=\"text-xs space-y-1 border-t border-dashed border-slate-100 pt-2.5 text-slate-500 leading-relaxed\">\n                      {record.nextPracticePrep && (\n                        <p>\n                          <strong className=\"text-slate-600 font-bold\">\344\270\213\346\254\241\347\267\264\347\277\222\345\271\271\351\203\250\345\215\224\345\212\251\357\274\232</strong>\n                          {record.nextPracticePrep}\n                        </p>\n                      )}\n                      {record.notes && (\n                        <p>\n                          <strong className=\"text-slate-600 font-bold\">\345\271\271\351\203\250\345\202\231\350\250\273\357\274\232</strong>\n                          {record.notes}\n                        </p>\n                      )}\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </div>\n  );"
      replacement_content: "  const progressColor = (ratio: number) => {\n    if (ratio >= 0.9) return \'bg-rose-500\';\n    if (ratio >= 0.7) return \'bg-amber-500\';\n    return \'bg-[#06C755]\';\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      {/* Dynamic Inventory Ring / Bars */}\n      <div className=\"bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Anchor className=\"text-[#06C755] animate-pulse\" size={20} />\n            <h2 className=\"text-sm font-bold text-slate-800\">\345\205\254\347\224\250\350\243\235\345\202\231\345\217\257\347\224\250\347\213\200\346\205\213</h2>\n          </div>\n          <button \n            onClick={() => {\n              setEditTotals({ ...totals });\n              setShowConfig(!showConfig);\n            }}\n            id=\"btn-toggle-inventory-config\"\n            className=\"flex items-center gap-1 text-xs text-slate-500 font-semibold hover:text-slate-800 p-1.5 rounded-lg hover:bg-slate-50 transition-colors\"\n          >\n            <Settings size={14} />\n            \350\250\255\345\256\232\347\270\275\351\207\217\n          </button>\n        </div>\n\n        {/* Configuration Panel */}\n        {showConfig && (\n          <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3.5 animate-fadeIn\">\n            <h3 className=\"text-xs font-bold text-slate-600 tracking-wider uppercase\">\346\233\264\346\224\271\351\232\212\351\203\250\350\243\235\345\202\231\347\270\275\345\272\253\345\255\230</h3>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\347\242\263\347\272\226\347\266\255\346\247\263\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.carbonPaddle} \n                  onChange={e => setEditTotals({ ...editTotals, carbonPaddle: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-[#06C755]\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\346\234\250\346\247\263\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.woodPaddle} \n                  onChange={e => setEditTotals({ ...editTotals, woodPaddle: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-[#06C755]\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\346\225\221\347\224\237\350\241\243\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.lifeJacket} \n                  onChange={e => setEditTotals({ ...editTotals, lifeJacket: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-[#06C755]\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-500 mb-1\">\345\261\201\345\242\212\347\270\275\346\225\270</label>\n                <input \n                  type=\"number\" \n                  value={editTotals.buttPad} \n                  onChange={e => setEditTotals({ ...editTotals, buttPad: Math.max(0, parseInt(e.target.value) || 0) })}\n                  className=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:outline-hidden focus:border-[#06C755]\"\n                />\n              </div>\n            </div>\n            <button \n              onClick={handleSaveConfig}\n              id=\"btn-save-inventory\"\n              className=\"w-full bg-[#06C755] hover:bg-[#05b54c] text-white font-bold text-xs py-2.5 rounded-xl flex items-center justify-center gap-2 transition-colors cursor-pointer\"\n            >\n              <Save size={15} />\n              \345\204\262\345\255\230\350\243\235\345\202\231\346\225\270\351\207\217\n            </button>\n          </div>\n        )}\n\n        {/* 4 Core Equipment Items Status Card */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {[\n            { label: \'\347\242\263\347\272\226\347\266\255\346\247\263\', stats: stats.carbonPaddle, unit: \'\346\224\257\', colorClass: \'from-slate-700 to-slate-900\', key: \'carbon\' },\n            { label: \'\346\234\250\346\247\263\', stats: stats.woodPaddle, unit: \'\346\224\257\', colorClass: \'from-amber-600 to-amber-800\', key: \'wood\' },\n            { label: \'\345\205\254\347\224\250\346\225\221\347\224\237\350\241\243\', stats: stats.lifeJacket, unit: \'\344\273\266\', colorClass: \'from-orange-500 to-orange-600\', key: \'jacket\' },\n            { label: \'\345\205\254\347\224\250\345\261\201\345\242\212\', stats: stats.buttPad, unit: \'\345\200\213\', colorClass: \'from-teal-500 to-teal-600\', key: \'pad\' }\n          ].map(item => {\n            const available = item.stats.total - item.stats.borrowed;\n            const ratio = item.stats.total > 0 ? item.stats.borrowed / item.stats.total : 0;\n            return (\n              <div key={item.key} className=\"bg-slate-50/50 rounded-xl p-3.5 border border-slate-200/60 flex flex-col justify-between space-y-2\">\n                <div className=\"flex justify-between items-start\">\n                  <span className=\"text-xs font-bold text-slate-500\">{item.label}</span>\n                  <span className=\"text-[10px] bg-slate-200/50 text-slate-600 font-bold px-1.5 py-0.5 rounded-md\">\n                    \347\270\275\345\272\253\345\255\230 {item.stats.total}\n                  </span>\n                </div>\n                <div className=\"flex items-baseline gap-1\">\n                  <span className={`text-2xl font-black ${available === 0 ? \'text-rose-500\' : \'text-slate-800\'}`}>\n                    {available}\n                  </span>\n                  <span className=\"text-xs font-semibold text-slate-500\">{item.unit} \345\217\257\345\200\237</span>\n                </div>\n                {/* Micro Progress Bar */}\n                <div className=\"w-full bg-slate-200 h-1.5 rounded-full overflow-hidden\">\n                  <div \n                    className={`h-full rounded-full transition-all duration-500 ${progressColor(ratio)}`}\n                    style={{ width: `${ratio * 100}%` }}\n                  />\n                </div>\n                <div className=\"text-[10px] text-slate-400 font-medium\">\n                  \345\267\262\345\200\237\345\207\272 {item.stats.borrowed} {item.unit}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Rentals Filter & List */}\n      <div className=\"space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-1.5\">\n            <h3 className=\"text-sm font-bold text-slate-800\">\345\200\237\347\224\250\345\220\215\345\226\256\350\210\207\347\242\272\350\252\215\347\213\200\346\205\213</h3>\n            <span className=\"text-xs font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200/60\">\n              {rentals.length} \347\255\206\347\264\200\351\214\204\n            </span>\n          </div>\n          <button \n            onClick={onRefresh}\n            id=\"btn-refresh-data\"\n            disabled={isLoading}\n            className=\"p-1.5 rounded-xl hover:bg-slate-100 text-slate-500 hover:text-slate-800 transition-colors cursor-pointer\"\n            title=\"\346\211\213\345\213\225\345\210\267\346\226\260\350\263\207\346\226\231\"\n          >\n            <RefreshCw size={15} className={isLoading ? \'animate-spin\' : \'\'} />\n          </button>\n        </div>\n\n        {/* Query Input */}\n        <div className=\"relative\">\n          <input \n            type=\"text\" \n            placeholder=\"\346\220\234\345\260\213\345\200\237\347\224\250\344\272\272\345\247\223\345\220\215\343\200\201\346\247\263\347\267\250\350\231\237\343\200\201\345\202\231\350\250\273...\"\n            value={searchQuery}\n            onChange={e => setSearchQuery(e.target.value)}\n            className=\"w-full bg-white border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 text-xs font-semibold text-slate-800 placeholder-slate-400 focus:outline-hidden focus:border-[#06C755] focus:ring-2 focus:ring-[#06C755]/10 shadow-2xs transition-all\"\n          />\n          <Search className=\"absolute left-3.5 top-3.5 text-slate-400\" size={15} />\n        </div>\n\n        {/* Filter Quick-Tabs */}\n        <div className=\"flex gap-1 overflow-x-auto pb-1 max-w-full no-scrollbar\">\n          {[\n            { id: \'all\', label: \'\345\205\250\351\203\250 \360\237\223\213\' },\n            { id: \'unconfirmed\', label: \'\345\271\271\351\203\250\346\234\252\347\242\272\350\252\215 \342\217\263\' },\n            { id: \'unpaid\', label: \'\346\234\252\344\273\230\346\254\276 \360\237\222\270\' },\n            { id: \'confirmed\', label: \'\345\267\262\347\242\272\350\252\215\345\220\210\346\240\274 \342\234\205\' }\n          ].map(tab => (\n            <button\n              key={tab.id}\n              onClick={() => setFilterType(tab.id as any)}\n              className={`text-xs font-bold px-3 py-2 rounded-xl whitespace-nowrap border transition-all cursor-pointer ${\n                filterType === tab.id \n                  ? \'bg-[#06C755] border-[#06C755] text-white shadow-xs\' \n                  : \'bg-white border-slate-200 text-slate-600 hover:bg-slate-50\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n\n        {/* List of Rentals */}\n        {error && (\n          <div className=\"bg-rose-50 border border-rose-100 rounded-xl p-4 flex gap-2.5 text-rose-700 text-xs font-semibold\">\n            <AlertCircle size={16} className=\"shrink-0\" />\n            <div>\n              <p>\350\263\207\346\226\231\345\212\240\350\274\211\345\244\261\346\225\227\357\274\232{error}</p>\n              <button onClick={onRefresh} className=\"mt-1 text-blue-600 underline font-bold\">\351\273\236\346\255\244\351\207\215\350\251\246</button>\n            </div>\n          </div>\n        )}\n\n        {isLoading ? (\n          <div className=\"bg-white rounded-2xl border border-slate-200 p-8 text-center space-y-3\">\n            <div className=\"w-8 h-8 border-3 border-[#06C755] border-t-transparent rounded-full animate-spin mx-auto\" />\n            <p className=\"text-xs text-slate-400 font-semibold\">\346\255\243\345\234\250\345\276\236 Google Sheet \350\274\211\345\205\245\345\215\263\346\231\202\350\243\235\345\202\231\347\247\237\345\200\237\347\213\200\346\205\213...</p>\n          </div>\n        ) : filteredRentals.length === 0 ? (\n          <div className=\"bg-white rounded-2xl border border-slate-200 p-8 text-center space-y-2\">\n            <HelpCircle size={32} className=\"text-slate-300 mx-auto\" />\n            <p className=\"text-sm font-semibold text-slate-500\">\347\204\241\347\254\246\345\220\210\346\242\235\344\273\266\347\232\204\345\200\237\347\224\250\347\264\200\351\214\204</p>\n            <p className=\"text-xs text-slate-400\">\350\253\213\345\230\227\350\251\246\346\233\264\346\224\271\351\227\234\351\215\265\345\255\227\346\210\226\347\257\251\351\201\270\345\210\206\351\241\236\343\200\202</p>\n          </div>\n        ) : (\n          <div className=\"space-y-3 max-h-[420px] overflow-y-auto pr-1\">\n            {filteredRentals.map(record => {\n              // Summarize gear for this borrower\n              const gears: string[] = [];\n              if (record.carbonPaddlesCount > 0) {\n                gears.push(`\347\242\263\347\272\226\346\247\263 x${record.carbonPaddlesCount}${record.carbonPaddleNumbers ? ` (${record.carbonPaddleNumbers})` : \'\'}`);\n              }\n              if (record.woodPaddlesCount > 0) {\n                gears.push(`\346\234\250\346\247\263 x${record.woodPaddlesCount}${record.woodPaddleNumbers ? ` (${record.woodPaddleNumbers})` : \'\'}`);\n              }\n              if (record.lifeJacketCount > 0) {\n                gears.push(`\346\225\221\347\224\237\350\241\243 x${record.lifeJacketCount}`);\n              }\n              if (record.buttPadCount > 0) {\n                gears.push(`\345\261\201\345\242\212 x${record.buttPadCount}`);\n              }\n\n              return (\n                <div \n                  key={record.id} \n                  className=\"bg-white rounded-xl p-4 border border-slate-200/80 hover:border-[#06C755]/30 hover:shadow-xs transition-all shadow-2xs space-y-3\"\n                >\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <div className=\"w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-600\">\n                        <User size={14} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-sm font-bold text-slate-800 leading-tight\">\n                          {record.borrower}\n                        </h4>\n                        <span className=\"text-[10px] text-slate-400 font-medium\">\n                          {record.timestamp}\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Status Badges */}\n                    <div className=\"flex flex-col items-end gap-1\">\n                      <div className=\"flex gap-1.5\">\n                        {record.confirmed ? (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-[#06C755]/10 text-[#06C755] border border-[#06C755]/20 px-1.5 py-0.5 rounded-md\">\n                            <ShieldCheck size={11} /> \345\271\271\351\203\250\345\267\262\347\242\272\350\252\215\n                          </span>\n                        ) : (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-amber-50 text-amber-600 border border-amber-200/60 px-1.5 py-0.5 rounded-md\">\n                            <ShieldAlert size={11} /> \346\234\252\346\240\270\345\260\215\n                          </span>\n                        )}\n                        \n                        {record.paymentConfirmed ? (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-blue-50 text-blue-600 border border-blue-200/60 px-1.5 py-0.5 rounded-md\">\n                            <CheckCircle2 size={11} /> \345\267\262\344\273\230\346\254\276\n                          </span>\n                        ) : (\n                          <span className=\"flex items-center gap-0.5 text-[10px] font-bold bg-slate-50 text-slate-500 border border-slate-200 px-1.5 py-0.5 rounded-md\">\n                            \346\234\252\346\240\270\346\254\276\n                          </span>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Borrowed Gear Details */}\n                  <div className=\"bg-slate-50/50 p-2.5 rounded-lg border border-slate-200/50\">\n                    <div className=\"text-[10px] text-slate-400 font-bold mb-1 uppercase tracking-wider\">\345\200\237\347\224\250\346\270\205\345\226\256</div>\n                    {gears.length > 0 ? (\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {gears.map((g, i) => (\n                          <span key={i} className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200/60 px-2 py-1 rounded-lg\">\n                            {g}\n                          </span>\n                        ))}\n                      </div>\n                    ) : (\n                      <span className=\"text-xs text-slate-400 font-semibold\">\345\203\205\347\231\273\350\250\230\357\274\214\347\204\241\345\200\237\347\224\250\350\243\235\345\202\231</span>\n                    )}\n                  </div>\n\n                  {/* Extra specs or comments */}\n                  {(record.nextPracticePrep || record.notes) && (\n                    <div className=\"text-xs space-y-1 border-t border-dashed border-slate-200 pt-2.5 text-slate-500 leading-relaxed\">\n                      {record.nextPracticePrep && (\n                        <p>\n                          <strong className=\"text-slate-600 font-bold\">\344\270\213\346\254\241\347\267\264\347\277\222\345\271\271\351\203\250\345\215\224\345\212\251\357\274\232</strong>\n                          {record.nextPracticePrep}\n                        </p>\n                      )}\n                      {record.notes && (\n                        <p>\n                          <strong className=\"text-slate-600 font-bold\">\345\271\271\351\203\250\345\202\231\350\250\273\357\274\232</strong>\n                          {record.notes}\n                        </p>\n                      )}\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </div>\n  );"
    }
