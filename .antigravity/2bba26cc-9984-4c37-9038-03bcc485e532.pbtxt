00 hover:bg-slate-900 disabled:bg-slate-200 text-white disabled:text-slate-400 px-4 rounded-xl flex items-center justify-center transition-all cursor-pointer disabled:cursor-not-allowed\"\n        >\n          <Send size={14} />\n        </button>\n      </form>\n    </div>\n  );\n};\n"
